[
  {"op": "core/text-transform", "engineConfig": {"facets": [], "mode": "row-based"}, "columnName": "email",
   "expression": "grel:value.trim().toLowercase().replace('@@', '@')", "onError": "keep-original", "repeat": false, "repeatCount": 10,
   "description": "email: trim, lower case, fix the double @@ typo"},
  {"op": "core/text-transform", "engineConfig": {"facets": [], "mode": "row-based"}, "columnName": "country",
   "expression": "grel:value.trim()", "onError": "keep-original", "repeat": false, "repeatCount": 10,
   "description": "country: trim spaces ('france ')"},
  {"op": "core/mass-edit", "engineConfig": {"facets": [], "mode": "row-based"}, "columnName": "country", "expression": "value",
   "edits": [
     {"from": ["France", "fr", "france", "FRA"], "fromBlank": false, "fromError": false, "to": "FR"},
     {"from": ["Belgium", "Belgique", "BEL"], "fromBlank": false, "fromError": false, "to": "BE"},
     {"from": ["Germany", "Allemagne", "DEU"], "fromBlank": false, "fromError": false, "to": "DE"},
     {"from": ["Spain", "Espagne", "es"], "fromBlank": false, "fromError": false, "to": "ES"}
   ],
   "description": "country: map the 17 spellings to ISO-2 codes FR / BE / DE / ES"},
  {"op": "core/text-transform", "engineConfig": {"facets": [], "mode": "row-based"}, "columnName": "loyalty_tier",
   "expression": "grel:value.trim().toLowercase().replace('platinium', 'platinum')", "onError": "keep-original", "repeat": false, "repeatCount": 10,
   "description": "loyalty_tier: trim, lower case, fix the 'Platinium' typo"},
  {"op": "core/text-transform", "engineConfig": {"facets": [], "mode": "row-based"}, "columnName": "birth_date",
   "expression": "grel:with(value.trim(), v, if(isNonBlank(v.match(/\\d{2}\\/\\d{2}\\/\\d{4}/)), v.split('/')[2] + '-' + v.split('/')[1] + '-' + v.split('/')[0], if(isNonBlank(v.match(/\\d{2}-\\d{2}-\\d{4}/)), v.split('-')[2] + '-' + v.split('-')[0] + '-' + v.split('-')[1], v.replace('/', '-'))))",
   "onError": "keep-original", "repeat": false, "repeatCount": 10,
   "description": "birth_date to ISO: DD/MM/YYYY (French) and MM-DD-YYYY (US) and YYYY/MM/DD become YYYY-MM-DD"},
  {"op": "core/text-transform", "engineConfig": {"facets": [], "mode": "row-based"}, "columnName": "signup_date",
   "expression": "grel:with(value.trim(), v, if(isNonBlank(v.match(/\\d{2}\\/\\d{2}\\/\\d{4}/)), v.split('/')[2] + '-' + v.split('/')[1] + '-' + v.split('/')[0], if(isNonBlank(v.match(/\\d{2}-\\d{2}-\\d{4}/)), v.split('-')[2] + '-' + v.split('-')[0] + '-' + v.split('-')[1], v.replace('/', '-'))))",
   "onError": "keep-original", "repeat": false, "repeatCount": 10,
   "description": "signup_date to ISO: DD/MM/YYYY (French) and MM-DD-YYYY (US) and YYYY/MM/DD become YYYY-MM-DD"},
  {"op": "core/text-transform", "engineConfig": {"facets": [], "mode": "row-based"}, "columnName": "postal_code",
   "expression": "grel:if(and(cells['country'].value == 'FR', value.length() == 4), '0' + value, value)",
   "onError": "keep-original", "repeat": false, "repeatCount": 10,
   "description": "postal_code: restore the leading zero lost on French codes (1000 -> 01000)"},
  {"op": "core/row-reorder", "mode": "row-based",
   "sorting": {"criteria": [{"valueType": "string", "column": "customer_id", "blankPosition": 2, "errorPosition": 1, "reverse": false, "caseSensitive": false}]},
   "description": "sort by customer_id so that duplicates are next to each other"},
  {"op": "core/blank-down", "engineConfig": {"facets": [], "mode": "row-based"}, "columnName": "customer_id",
   "description": "blank down customer_id: the second copy of a duplicated id becomes blank"},
  {"op": "core/row-removal",
   "engineConfig": {"facets": [{"type": "list", "name": "customer_id", "expression": "isBlank(value)", "columnName": "customer_id", "invert": false, "omitBlank": false, "omitError": false,
     "selection": [{"v": {"v": true, "l": "true"}}], "selectBlank": false, "selectError": false}], "mode": "row-based"},
   "description": "remove the 8 exact duplicate rows (customer_id now blank)"},
  {"op": "core/column-addition", "engineConfig": {"facets": [], "mode": "row-based"}, "baseColumnName": "email", "newColumnName": "dq_flag", "columnInsertIndex": 13,
   "expression": "grel:(if(isBlank(value), 'email_missing;', if(isNull(value.match(/[^@\\s]+@[^@\\s]+\\.[a-z]{2,}/)), 'email_invalid;', '')) + if(isBlank(cells['country']), 'country_missing;', '') + if(or(cells['birth_date'].value < '1906-01-01', cells['birth_date'].value > '2026-11-25'), 'birth_date_impossible;', '')).replace(/;$/, '')",
   "onError": "set-to-blank",
   "description": "dq_flag: rows the business must decide on (not fixed automatically)"}
]
